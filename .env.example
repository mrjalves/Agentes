# Configurações de API para Agentes de Suporte ITIL e Ferramentas Gemini

# Chave padrão da Google Gemini API (usada por FileSearch e scripts da raiz)
GEMINI_API_KEY=your_gemini_api_key_here

# Chaves específicas por agente/experimento (AGENTE_ITIL)
GEMINI_API_KEY_CHAT=your_gemini_api_key_here
GEMINI_API_KEY_CHAT_STREAM=your_gemini_api_key_here
GEMINI_API_KEY_RAG=your_gemini_api_key_here
GEMINI_API_KEY_RAG_ADAPTATIVO=your_gemini_api_key_here
GEMINI_API_KEY_PLAN_EXEC=your_gemini_api_key_here
GEMINI_API_KEY_PLAN_EXEC_AVALIAR=your_gemini_api_key_here

# Chave da Tavily API (usada no RAG Adaptativo para busca externa na web quando necessário)
TAVILY_API_KEY=your_tavily_api_key_here
